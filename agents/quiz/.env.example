# Prefer repo-root env; override locally as needed.

# --- LiveKit: use the Docker SFU in docker-compose (service: livekit) ---
# Host / Next.js browser:  ws://localhost:7880
# Containers on app-network: ws://livekit:7880
# Do NOT point these at LiveKit Cloud for local quiz voice.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=quiz

USE_LOCAL_VOICE=true
WHISPER_MODEL=distil-small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Empty → agents/quiz/models/… then imb/en_US-lessac-medium.onnx
PIPER_MODEL_PATH=
PIPER_USE_CUDA=false
# Speech rate: 1.0 = normal, >1 faster (e.g. 1.25), <1 slower (e.g. 0.85).
# Or set PIPER_LENGTH_SCALE instead (Piper-native; higher = slower).
PIPER_SPEECH_RATE=1.0

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# LangGraph MongoDB checkpointer (short-term agent memory)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=tobu_ai
CHECKPOINT_COLLECTION=langgraph_checkpoints
CHECKPOINT_WRITES_COLLECTION=langgraph_checkpoint_writes
