# Copy to `.env` in this directory and fill in real values for local runs.
# In docker-compose, these are typically supplied as real environment
# variables instead and this file is only a reference.

# ============================
# MongoDB (checkpointer + per-user model preferences)
# ============================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=imbbox2_agent
# Optional full override instead of the discrete fields above:
# MONGO_URI=mongodb://admin:password123@localhost:27017/?authSource=admin

# ============================
# MinIO (syllabus source file downloads)
# ============================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=documents-bucket

# ============================
# Default LLM provider (used only when a user has no saved preference)
# ============================
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini
DEFAULT_MODEL_TEMPERATURE=0.3

# Fallback provider credentials -- per-user credentials stored in MongoDB
# (see `agent/persistence/mongodb/preferences.py`) always take priority.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
