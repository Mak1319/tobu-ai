# ---------- MongoDB ----------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_strong_password
MONGO_DB=imbbox
MONGO_PORT=27017
# Connection string the agent/worker will use
MONGODB_URI=mongodb://admin:replace_with_strong_password@mongodb:27017/imbbox?authSource=admin

# ---------- Redis ----------
REDIS_PASSWORD=replace_with_strong_password
REDIS_PORT=6379
# Connection string the agent/worker will use
REDIS_URL=redis://:replace_with_strong_password@redis:6379/0

# Channel MinIO publishes document-upload events to (Redis pub/sub)
REDIS_NOTIFY_CHANNEL=minio.documents.uploaded

# ---------- MinIO ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace_with_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoints the agent/worker will use
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_DOCUMENTS=documents-bucket
MINIO_BUCKET_PROCESSED=processed-documents
