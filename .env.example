# =============================================================================
# imbbox2 — committed env template (safe defaults / placeholders)
# Copy to .env.all for local secrets (gitignored), or keep using per-service .env
# =============================================================================

# ---------- MongoDB ----------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_password
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_strong_password
MONGO_DB=imbbox
MONGO_PORT=27017
MONGODB_URI=mongodb://admin:replace_with_strong_password@localhost:27017/imbbox?authSource=admin
MONGODB_URL=mongodb://admin:replace_with_strong_password@localhost:27017
MONGODB_DB=tobu_ai
HASH_COLLECTION=hashContentMap

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_strong_password
REDIS_URL=redis://:replace_with_strong_password@localhost:6379/0

# Canonical MinIO → worker list (RPUSH / BLPOP)
REDIS_EVENT_KEY=minio-events
REDIS_EVENT_LIST=minio-events

# Canonical Docling / topicable result stream (XADD / XREAD)
STREAM_RESULT_KEY=docling_result
REDIS_OUTPUT_STREAM=docling_result
STREAM_MAXLEN=10000
STREAM_HISTORY_COUNT=200
REDIS_BLOCK_SECONDS=5

# Quiz agents bus
QUIZ_AGENT_STREAM=quiz_agent_bus
QUIZ_STREAM_MAXLEN=10000

# Legacy aliases (prefer STREAM_RESULT_KEY / REDIS_EVENT_KEY)
# PUBSUB_RESULT_CHANNEL=docling_results
# REDIS_INPUT_STREAM=minio-events
# REDIS_NOTIFY_CHANNEL=minio.documents.uploaded

# ---------- MinIO ----------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace_with_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace_with_strong_password
MINIO_REGION=us-east-1
MINIO_BUCKET=documents-bucket
DOCUMENTS_BUCKET=documents-bucket
MINIO_BUCKET_DOCUMENTS=documents-bucket
MINIO_BUCKET_PROCESSED=processed-documents
PROCESSED_BUCKET=processed-documents
UPLOADED_BUCKET=uploaded-documents
MINIO_NOTIFY_ARN=arn:minio:sqs::primary:redis

# ---------- LiveKit (voice) ----------
# LiveKit — local Docker SFU (`docker compose` service `livekit`), not Cloud.
# Browser / Next.js: NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Quiz agent container: LIVEKIT_URL=ws://livekit:7880 (set in compose)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_AGENT_NAME=quiz

# ---------- tobu-ai-ui ----------
AUTH_SECRET=replace-with-openssl-rand-base64-32
SMTP_URL=
SMTP_FROM="Tobu AI <no-reply@tobu.ai>"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- topicable / LLM ----------
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT=180
LOG_LEVEL=INFO
DEBUG=0
FORCE_DOCLING=0
