# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# MinIO notifies via RPUSH on this list; worker consumes with BLPOP
REDIS_EVENT_LIST=minio-events
# Worker publishes results with XADD
REDIS_OUTPUT_STREAM=docling_result
REDIS_BLOCK_SECONDS=5
STREAM_MAXLEN=10000

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tobu_ai
HASH_COLLECTION=hashContentMap

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
UPLOADED_BUCKET=uploaded-documents
PROCESSED_BUCKET=processed-documents

# LLM (Ollama / llama.cpp OpenAI-compatible). CLI flags override these.
# Root URL is fine — worker uses /v1/chat/completions (OpenAI) with /api/chat fallback
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
# Must match an installed Ollama tag (e.g. gemma4:cloud, qwen2.5:0.5b)
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT=180

LOG_LEVEL=INFO
# Set DEBUG=1 or run with --debug for verbose step-by-step logs
DEBUG=0
# Force Docling for every file (skip text extraction) — useful to test Docling
FORCE_DOCLING=0
